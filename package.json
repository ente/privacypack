{
	"name": "privacypack",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "npm run assets:check && next build",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit --incremental false",
		"catalog:validate": "node scripts/validate-catalog.mjs",
		"assets:generate": "node scripts/asset-versions.mjs",
		"assets:check": "node scripts/asset-versions.mjs --check",
		"test:catalog": "node --test tests/catalog-validation.mjs",
		"test:unit": "node --test tests/infra-unit.mjs tests/pack-unit.mjs tests/fit-name-unit.mjs tests/catalog-validation.mjs",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:dev": "node scripts/run-e2e.mjs --dev",
		"check": "npm run assets:check && npm run catalog:validate && npm run test:unit && npm run typecheck && npm run lint && npm run build && npm run test:e2e"
	},
	"dependencies": {
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"clsx": "^2.1.1",
		"html2canvas-pro": "^1.5.11",
		"lucide-react": "^0.539.0",
		"next": "15.5.27",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.11",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "15.5.27",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sharp": "0.35.5",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.3.7",
		"typescript": "^5"
	},
	"overrides": {
		"postcss": "8.5.29",
		"sharp": "$sharp",
		"minimatch@3": {
			"brace-expansion": "1.1.21"
		}
	}
}
