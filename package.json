{
	"name": "privacypack",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "npm run assets:check && next build",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit --incremental false",
		"catalog:validate": "node scripts/validate-catalog.mjs",
		"assets:generate": "node scripts/asset-versions.mjs",
		"assets:check": "node scripts/asset-versions.mjs --check",
		"test:catalog": "node --test tests/catalog-validation.mjs",
		"test:unit": "node --test tests/infra-unit.mjs tests/pack-unit.mjs tests/fit-name-unit.mjs tests/catalog-validation.mjs tests/picker-state-unit.mjs",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:dev": "node scripts/run-e2e.mjs --dev",
		"check": "npm run assets:check && npm run catalog:validate && npm run test:unit && npm run typecheck && npm run lint && npm run build && npm run test:e2e"
	},
	"dependencies": {
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"clsx": "^2.1.1",
		"html2canvas-pro": "^1.6.7",
		"lucide-react": "^1.52.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.12.0",
		"eslint-config-next": "16.4.0",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "0.35.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"postcss": "8.5.29",
		"sharp": "$sharp",
		"minimatch@3": {
			"brace-expansion": "1.1.21"
		}
	}
}
